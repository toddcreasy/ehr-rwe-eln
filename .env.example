# Every env var the app and docker-compose.yml read. Copy to .env and fill in.
# .env is gitignored and holds the only copy of your secrets.

# Database: the db service in docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehr_rwe_eln
DB_USER=postgres
DB_PASSWORD=

# Lake: OMOP as Iceberg in S3 Tables, queried through Redshift Serverless. The bucket ARN holds the
# account ID: arn:aws:s3tables:us-east-1:<account>:bucket/ehr-rwe-eln-omop. The rest have defaults
# (cdm, us-east-1, ehr-rwe-eln, ehr_rwe_eln, awsdatacatalog.omop_cdm). AWS credentials come from
# the AWS CLI profile, not this file.
LAKE_TABLE_BUCKET_ARN=
# Where OMOP readers (trial emulation, synthetic data, genomics scripts) read from: lake (default,
# through Redshift) or staging (the Postgres the ETL builds in).
OMOP_SOURCE=
LAKE_NAMESPACE=
AWS_REGION=
REDSHIFT_WORKGROUP=
REDSHIFT_DATABASE=
REDSHIFT_LAKE_SCHEMA=

# API. LOG_LEVEL defaults to INFO. FRONTEND_DIR defaults to frontend/out; the Docker image sets it.
# APP_PORT is the host port for the Compose app service, default 8000.
LOG_LEVEL=
# true only in the public AWS deployment (no login): recording curator decisions returns 403.
PUBLIC_DEMO=
# Most tokens /api/agent may bill in one day, US Eastern; then it returns 429 until midnight.
# Defaults to 150000. Each address also gets 10 calls an hour.
DAILY_TOKEN_LIMIT=
FRONTEND_DIR=
APP_PORT=

# Scheduled privacy checks on synthetic releases (the Compose monitor service), in hours.
# Defaults to 24.
MONITOR_INTERVAL_HOURS=

# Agent: your own Anthropic API key (console.anthropic.com). MODEL defaults to claude-opus-5-5
# and is used for every model call.
ANTHROPIC_API_KEY=
MODEL=
