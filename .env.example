# Every env var the app reads. No values. Phases add to this file.

# Phase 2: data layer. ARN from the DataStack output DatabaseSecretArn.
DATABASE_SECRET_ARN=
AWS_REGION=

# Phase 3: backend API. Deployed, ECS injects these from the database secret.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
LOG_LEVEL=

# Phase 4: agent layer. Model IDs are Bedrock inference profiles; ARN from AgentStack output.
MODEL_SMALL=
MODEL_LARGE=
AGENT_RUNTIME_ARN=

# Phase 5: AgentCore Gateway MCP endpoint (AgentStack output GatewayUrl). Unset = local tools only.
GATEWAY_URL=

# Phase 7: Cognito user pool the API verifies tokens against (BackendStack outputs).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
