# Every env var the app reads. No values. Phases add to this file.

# Phase 2: data layer. ARN from the DataStack output DatabaseSecretArn.
DATABASE_SECRET_ARN=
AWS_REGION=

# Phase 3: backend API. Deployed, ECS injects these from the database secret.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
LOG_LEVEL=

# Agent: your own Anthropic API key (console.anthropic.com). Model IDs default to
# claude-haiku-5-5 (small) and claude-sonnet-5-5 (large).
ANTHROPIC_API_KEY=
MODEL_SMALL=
MODEL_LARGE=

# Built frontend the API serves at /. Defaults to frontend/out; the Docker image sets it.
FRONTEND_DIR=
# Host port for the Compose app service. Defaults to 8000.
APP_PORT=
