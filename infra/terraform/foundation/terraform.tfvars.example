# Copy to terraform.tfvars (gitignored) and fill in.
budget_email = "you@example.com"

# Your SSO role, with its path. Find it with:
#   aws iam list-roles --query "Roles[?starts_with(RoleName,'AWSReservedSSO_AdministratorAccess')].Arn"
lake_admin_arns = ["arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_xxxx"]
